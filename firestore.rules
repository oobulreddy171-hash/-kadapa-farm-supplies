rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MVP note: bookings are readable by signed-in users for this simple demo.
    // Before public launch, restrict reads to admin/operator roles and expose only
    // farmer-specific booking status through a server/API or carefully designed rules.
    match /bookings/{bookingId} {
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.service is string
        && request.resource.data.village is string;
      allow read: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.status in ['Confirmed','Assigned','In progress','Completed','Cancelled'];
      allow delete: if false;
    }
  }
}
